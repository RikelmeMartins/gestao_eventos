# ==========================================
#  Gestão de Eventos Acadêmicos - .gitignore
# ==========================================

# ---------- Frontend (Node / React / Vite) ----------
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Backend (Python / Flask) ----------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
instance/
*.log

# ---------- Variáveis de ambiente (senhas!) ----------
.env
.env.*
!.env.example

# ---------- Uploads / arquivos gerados ----------
uploads/
certificados_gerados/

# ---------- Editor / Sistema ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
